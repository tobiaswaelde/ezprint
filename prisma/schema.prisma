generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  displayName  String
  passwordHash String
  locale       String    @default("de-DE")
  sessions     Session[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AppSettings {
  id                     Int      @id @default(1)
  currency               String   @default("EUR")
  defaultLocale          String   @default("de-DE")
  electricityPricePerKwh Decimal  @default(0)
  calculationVersion     String   @default("1")
  printSeriesEnabled     Boolean  @default(true)
  spoolManagementEnabled Boolean  @default(true)
  spoolmanEnabled        Boolean?
  spoolmanUrl            String?
  spoolmanAuthorization  String?
  bambubuddyEnabled      Boolean?
  bambubuddyUrl          String?
  bambubuddyApiKey       String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Customer {
  series     PrintSeries[]
  id         String     @id @default(cuid())
  name       String
  email      String?
  note       String?
  excludeFromDashboard Boolean       @default(false)
  archivedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  printJobs  PrintJob[]

  @@index([name])
  @@index([archivedAt])
}

model Printer {
  bambuId Int? @unique
  bambuState String?
  bambuSyncedAt DateTime?
  bambuError String?
  trayMappings BambuTrayMapping[]
  id                    String             @id @default(cuid())
  name                  String
  manufacturerId        String
  manufacturer          Manufacturer       @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  model                 String?
  purchasePrice         Decimal
  expectedLifetimeHours Decimal
  averagePowerWatts     Int
  note                  String?
  archivedAt            DateTime?
  components            PrinterComponent[]
  printJobs             PrintJob[]
  printParts            PrintPart[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([name])
  @@index([manufacturerId])
  @@index([archivedAt])
}

model Manufacturer {
  spoolmanId Int? @unique
  id         String      @id @default(cuid())
  name       String      @unique
  note       String?
  archivedAt DateTime?
  components Component[]
  filaments  Filament[]
  printers   Printer[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([archivedAt])
}

model Component {
  id                    String                @id @default(cuid())
  type                  String
  name                  String
  alwaysUsed            Boolean               @default(false)
  manufacturerId        String?
  manufacturer          Manufacturer?         @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  model                 String?
  purchasePrice         Decimal
  expectedLifetimeHours Decimal
  note                  String?
  archivedAt            DateTime?
  printers              PrinterComponent[]
  usages                PrintComponentUsage[]
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([name])
  @@index([type])
  @@index([manufacturerId])
  @@index([archivedAt])
}

model PrinterComponent {
  printerId   String
  componentId String
  printer     Printer   @relation(fields: [printerId], references: [id], onDelete: Cascade)
  component   Component @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@id([printerId, componentId])
  @@index([componentId])
}

model Filament {
  spoolmanId Int? @unique
  id             String               @id @default(cuid())
  name           String
  manufacturerId String
  manufacturer   Manufacturer         @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  material       String
  minimumStockGrams String @default("0")
  spools         Spool[]
  colorName      String
  colorHex       String               @default("#FFFFFF")
  purchasePrice  Decimal
  netWeightGrams Decimal
  note           String?
  archivedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  usages         PrintFilamentUsage[]

  @@index([name])
  @@index([manufacturerId])
  @@index([material])
  @@index([archivedAt])
}

model PrintJob {
  parts PrintPart[]
  bambuLinks BambuPrintLink[]
  seriesId             String?
  series               PrintSeries? @relation(fields: [seriesId], references: [id], onDelete: Restrict)
  repeatOfId           String?
  repeatOf             PrintJob? @relation("PrintRepeats", fields: [repeatOfId], references: [id], onDelete: Restrict)
  repeats              PrintJob[] @relation("PrintRepeats")
  salesValue           String?
  id                   String                @id @default(cuid())
  name                 String
  customerId           String?
  customer             Customer?             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  printerId            String
  printer              Printer               @relation(fields: [printerId], references: [id], onDelete: Restrict)
  status               String                @default("DRAFT")
  notes                String?
  quantity             Int                   @default(1)
  totalDurationSeconds Int
  formulaVersion       String
  currency             String
  totalCost            Decimal
  completedAt          DateTime?
  paidAt               DateTime?
  archivedAt           DateTime?
  componentUsages      PrintComponentUsage[]
  filamentUsages       PrintFilamentUsage[]
  outcome              PrintOutcome?
  retryOfId            String?
  retryOf              PrintJob?             @relation("PrintRetries", fields: [retryOfId], references: [id], onDelete: Restrict)
  retries              PrintJob[]            @relation("PrintRetries")
  snapshot             PrintCostSnapshot?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([name])
  @@index([status, archivedAt])
  @@index([customerId])
  @@index([printerId])
  @@index([completedAt])
  @@index([paidAt])
}

model PrintPart {
  bambuLink BambuPrintLink?
  id String @id @default(cuid())
  printJobId String
  printJob PrintJob @relation(fields: [printJobId], references: [id], onDelete: Cascade)
  position Int
  printerId String
  printer Printer @relation(fields: [printerId], references: [id], onDelete: Restrict)
  totalDurationSeconds Int
  snapshotJson String?
  componentUsages PrintComponentUsage[]
  filamentUsages PrintFilamentUsage[]

  @@unique([printJobId, position])
  @@index([printerId])
}

model PrintComponentUsage {
  partId String
  part PrintPart @relation(fields: [partId], references: [id], onDelete: Cascade)
  id                     String    @id @default(cuid())
  printJobId             String
  printJob               PrintJob  @relation(fields: [printJobId], references: [id], onDelete: Cascade)
  componentId            String
  component              Component @relation(fields: [componentId], references: [id], onDelete: Restrict)
  componentType          String
  componentName          String
  purchasePrice          Decimal
  expectedLifetimeHours  Decimal
  hourlyRate             Decimal
  appliedDurationSeconds Int
  lineCost               Decimal
  createdAt              DateTime  @default(now())

  @@index([printJobId])
  @@index([componentId])
}

model PrintFilamentUsage {
  partId String
  part PrintPart @relation(fields: [partId], references: [id], onDelete: Cascade)
  id             String   @id @default(cuid())
  printJobId     String
  printJob       PrintJob @relation(fields: [printJobId], references: [id], onDelete: Cascade)
  spoolId        String?
  spool          Spool? @relation(fields: [spoolId], references: [id], onDelete: Restrict)
  spoolCode      String?
  stockMovements StockMovement[]
  filamentId     String
  filament       Filament @relation(fields: [filamentId], references: [id], onDelete: Restrict)
  filamentName   String
  manufacturer   String
  material       String
  purchasePrice  Decimal
  netWeightGrams Decimal
  costPerGram    Decimal
  usedGrams      Decimal
  lineCost       Decimal
  createdAt      DateTime @default(now())

  @@index([printJobId])
  @@index([filamentId])
}

model PrintCostSnapshot {
  salesValue                   String?
  calculationJson              String?
  id                           String   @id @default(cuid())
  printJobId                   String   @unique
  printJob                     PrintJob @relation(fields: [printJobId], references: [id], onDelete: Cascade)
  quantity                     Int      @default(1)
  costPerUnit                  String?
  electricityPricePerKwh       Decimal
  printerName                  String
  printerPurchasePrice         Decimal
  printerExpectedLifetimeHours Decimal
  printerHourlyRate            Decimal
  printerPowerWatts            Int
  printerCost                  Decimal
  componentCost                Decimal
  filamentCost                 Decimal
  electricityCost              Decimal
  totalCost                    Decimal
  currency                     String
  formulaVersion               String
  calculatedAt                 DateTime @default(now())
}

model PrintOutcome {
  corrections     PrintOutcomeCorrection[]
  id              String   @id @default(cuid())
  printJobId      String   @unique
  printJob        PrintJob @relation(fields: [printJobId], references: [id], onDelete: Restrict)
  status          String
  durationSeconds Int
  failureReason   String?
  note            String?
  inputSnapshot   String
  costSnapshot    String
  stockTracked    Boolean  @default(true)
  recordedAt      DateTime @default(now())
}

model Spool {
  trayMappings BambuTrayMapping[]
  spoolmanId Int? @unique
  stockAuthority String @default("NATIVE")
  remoteRemainingGrams String?
  remoteState String?
  syncedAt DateTime?
  syncError String?
  syncOperations SpoolSyncOperation[]
  id               String @id @default(cuid())
  code             String @unique
  filamentId       String
  filament         Filament @relation(fields: [filamentId], references: [id], onDelete: Restrict)
  purchaseLot      String?
  location         String?
  acquiredAt       DateTime?
  purchasePrice    String
  initialNetWeightGrams String
  legacy           Boolean @default(false)
  archivedAt       DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  movements        StockMovement[]
  usages           PrintFilamentUsage[]

  @@index([filamentId, archivedAt])
}

model StockMovement {
  id               String @id @default(cuid())
  spoolId          String
  spool            Spool @relation(fields: [spoolId], references: [id], onDelete: Restrict)
  kind             String
  grams            String
  note             String?
  operationKey     String @unique
  printUsageId     String?
  printUsage       PrintFilamentUsage? @relation(fields: [printUsageId], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now())

  @@index([spoolId, id])
  @@index([printUsageId])
}

model PrintOutcomeCorrection {
  id            String @id @default(cuid())
  outcomeId     String
  outcome       PrintOutcome @relation(fields: [outcomeId], references: [id], onDelete: Restrict)
  revision      Int
  operationKey  String @unique
  inputSnapshot String
  costSnapshot  String
  recordedAt    DateTime @default(now())

  @@unique([outcomeId, revision])
}

model PrintSeries {
  id             String @id @default(cuid())
  name           String
  customerId     String?
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: Restrict)
  targetQuantity Int?
  notes          String?
  status         String @default("OPEN")
  autoComplete   Boolean @default(true)
  archivedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  prints         PrintJob[]

  @@index([customerId, archivedAt])
}

model SpoolSyncOperation {
  id String @id @default(cuid())
  operationKey String @unique
  spoolId String
  spool Spool @relation(fields: [spoolId], references: [id], onDelete: Restrict)
  remoteId Int
  grams String
  state String @default("PENDING")
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([state, createdAt])
}

model BambuPrintLink {
  id String @id @default(cuid())
  partId String @unique
  part PrintPart @relation(fields: [partId], references: [id], onDelete: Restrict)
  printJobId String
  printJob PrintJob @relation(fields: [printJobId], references: [id], onDelete: Restrict)
  remoteLogId Int @unique
  cachedJson String
  syncedAt DateTime @default(now())
  error String?
  importedJson String?
  importedAt DateTime?

  @@index([printJobId])
}
model BambuTrayMapping {
  id String @id @default(cuid())
  printerId String
  printer Printer @relation(fields: [printerId], references: [id], onDelete: Restrict)
  slot String
  spoolId String
  spool Spool @relation(fields: [spoolId], references: [id], onDelete: Restrict)
  @@unique([printerId, slot])
}
