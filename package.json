{
  "name": "ezprint",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "build": "nuxt build",
    "pwa:check": "tsx scripts/check-pwa.ts",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "typecheck": "nuxt typecheck",
    "test": "pnpm test:unit && pnpm test:component",
    "test:unit": "vitest run",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:integration": "pnpm test:seed && pnpm test:setup-demo && tsx tests/integration/api-smoke.ts",
    "test:seed": "tsx tests/integration/seed-database.ts",
    "test:setup-demo": "tsx tests/integration/setup-demo-data.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:pwa:e2e": "playwright test --config playwright.pwa.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/ensure-database.ts && prisma migrate dev",
    "db:deploy": "tsx scripts/ensure-database.ts && prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset-password": "tsx scripts/reset-password.ts",
    "db:backup": "tsx scripts/backup-database.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "tsx scripts/check-docs.ts",
    "docs:screenshots": "playwright test --config playwright.screenshots.config.ts",
    "test:docs:e2e": "playwright test --config playwright.docs.config.ts",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only && prettier --write pnpm-lock.yaml",
    "release": "changeset publish"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.150",
    "@iconify-json/simple-icons": "1.2.101",
    "@iconify-json/tabler": "1.2.43",
    "@node-rs/argon2": "2.2.2",
    "@nuxt/ui": "4.12.0",
    "@nuxtjs/i18n": "10.6.0",
    "@pinia/nuxt": "1.0.3",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/client": "7.10.1",
    "@querry-kit/nuxt": "0.2.9",
    "@querry-kit/nuxt-ui": "3.3.9",
    "@tanstack/table-core": "9.3.1",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "15.0.0",
    "archiver": "8.0.0",
    "better-sqlite3": "13.0.3",
    "dayjs": "1.11.23",
    "decimal.js": "10.6.0",
    "dotenv": "18.0.9",
    "echarts": "6.1.0",
    "nuxt": "4.6.3",
    "pinia": "4.1.0",
    "unzipper": "0.12.5",
    "uqr": "0.1.3",
    "vue-echarts": "8.3.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@changesets/cli": "3.0.3",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.3.4",
    "@playwright/test": "1.64.1",
    "@types/archiver": "8.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.6",
    "@types/unzipper": "0.10.11",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/test-utils": "2.5.1",
    "eslint": "10.14.0",
    "happy-dom": "21.0.4",
    "pdfjs-dist": "6.4.299",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitepress": "1.6.4",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13",
    "@typescript/native": "npm:typescript@^7.0.2"
  }
}
