{
  "name": "ezprint",
  "version": "0.8.8",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "pwa:check": "tsx scripts/check-pwa.ts",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && prisma generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "typecheck": "nuxt typecheck",
    "test": "pnpm test:unit && pnpm test:component",
    "test:unit": "vitest run",
    "test:component": "vitest run --config vitest.component.config.ts",
    "test:integration": "pnpm test:seed && pnpm test:setup-demo && tsx tests/integration/api-smoke.ts",
    "test:seed": "tsx tests/integration/seed-database.ts",
    "test:setup-demo": "tsx tests/integration/setup-demo-data.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:pwa:e2e": "playwright test --config playwright.pwa.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "tsx scripts/ensure-database.ts && prisma migrate dev",
    "db:deploy": "tsx scripts/ensure-database.ts && prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset-password": "tsx scripts/reset-password.ts",
    "db:backup": "tsx scripts/backup-database.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "docs:check": "tsx scripts/check-docs.ts",
    "docs:screenshots": "playwright test --config playwright.screenshots.config.ts",
    "test:docs:e2e": "playwright test --config playwright.docs.config.ts",
    "changeset": "changeset",
    "version": "changeset version && pnpm install --lockfile-only && prettier --write pnpm-lock.yaml",
    "release": "changeset publish"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.130",
    "@iconify-json/simple-icons": "1.2.95",
    "@iconify-json/tabler": "1.2.38",
    "@node-rs/argon2": "2.2.1",
    "@nuxt/ui": "4.11.1",
    "@nuxtjs/i18n": "10.6.0",
    "@pinia/nuxt": "1.0.2",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@querry-kit/nuxt": "0.2.4",
    "@querry-kit/nuxt-ui": "3.3.2",
    "@tanstack/table-core": "8.21.3",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "14.4.0",
    "archiver": "7.0.1",
    "better-sqlite3": "12.11.1",
    "dayjs": "1.11.23",
    "decimal.js": "10.6.0",
    "dotenv": "17.4.2",
    "echarts": "6.1.0",
    "nuxt": "4.5.2",
    "pinia": "3.0.3",
    "unzipper": "0.12.3",
    "uqr": "0.1.3",
    "vue-echarts": "8.3.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@changesets/cli": "3.0.2",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.3.2",
    "@playwright/test": "1.63.0",
    "@types/archiver": "6.0.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.10.1",
    "@types/unzipper": "0.10.11",
    "@vitest/coverage-v8": "5.0.0",
    "@vue/test-utils": "2.4.6",
    "eslint": "10.10.0",
    "happy-dom": "20.14.3",
    "pdfjs-dist": "5.5.207",
    "prettier": "3.6.2",
    "prisma": "7.10.0",
    "tsx": "4.20.6",
    "typescript": "6.0.3",
    "vitepress": "1.6.4",
    "vitest": "5.0.0",
    "vue-tsc": "3.1.0"
  }
}
